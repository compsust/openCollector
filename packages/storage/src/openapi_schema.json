                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "status": {
                        "$ref": "#/components/schemas/StatusEnum"
                    },
                    "last_value": {
                        "oneOf": [
                            {
                                "type": "number"
                            },
                            {
                                "type": "null"
                            }
                        ]
                    }
                },
                "type": "object",
                "required": [
                    "id",
                    "name",
                    "status"
                ],
                "title": "SensorSummary"
            },
            "StatusEnum": {
                "type": "string",
                "enum": [
                    "Unknown",
                    "Operational",
                    "Dropped",
                    "Error"
                ],
                "title": "StatusEnum",
                "description": "\nDescribes the knowledge that the storage node\nhas about how a collector node or sensor is functioning.\n\nStatuses are stored in-memory, and thus a restart of the\nserver process will result in statuses being reset.\n\nOptions:\n    Unknown: No data has been received from the\n        node or sensor since the server process has begun.\n    Operational: Data has been received from the node or\n        sensor recently.\n    Dropped: Data has been received from the node or sensor\n        since the server process has begun but not recently.\n    Error: An error has been received from the node or sensor.\n"
            }
        }
