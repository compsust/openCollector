                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "status": {
                        "$ref": "#/components/schemas/StatusEnum"
                    },
                    "type": {
                        "type": "string"
                    },
                    "latest_record": {
                        "type": "string",
                        "format": "date-time"
