// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/docker-existing-dockerfile
{
	"name": "SFU Computational Sustainability Open Collector",
	"dockerComposeFile": "./docker-compose.yml",
	"service": "open-collector",
	"workspaceFolder": "/workspace",

	// Features to add to the dev container. More info: https://containers.dev/features.
	"features": {},

	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	// "forwardPorts": [],

	// Commands to be run after the container is created.
	"postCreateCommand": {
		"dependencies": ["uv", "sync"]
	},

	"containerEnv": {
		// When installing the QuestDB Python package, which is only needed for dev, it needs to install rust.
		"SETUP_DO_RUSTUP_INSTALL": "1"
	},

	// Configure tool-specific properties.
	"customizations": {
		"vscode": {
			"settings": {
				"python.defaultInterpreterPath": ".venv/bin/python",
				"python.analysis.typeCheckingMode": "basic",
				"python.analysis.autoImportCompletions": true,
				// https://micropython-stubs.readthedocs.io/en/main/22_vscode.html
				"python.analysis.diagnosticSeverityOverrides": {
						"reportMissingModuleSource": "none"
				},
				"python.analysis.extraPaths": [
					".venv/lib/python3.13/site-packages",
					"typings"
				]
			},
			"extensions": [
				"pomdtr.excalidraw-editor",
				"njpwerner.autodocstring",
				"mgesbert.python-path",
				"ms-python.python",
				"ms-python.vscode-pylance",
				"njqdev.vscode-python-typehint"
			]
		}
	},

	// Uncomment to connect as an existing user other than the container default. More info: https://aka.ms/dev-containers-non-root.
	"remoteUser": "root"
}
